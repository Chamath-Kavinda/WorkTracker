{
  "name": "worktracker",
  "version": "6.3.0",
  "description": "Work Time Tracker - Track your tasks with precision",
  "author": "Chama Bro",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --win nsis --x64",
    "build-portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.worktracker.app",
    "productName": "WorkTracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!*.nsi",
      "!*.bat",
      "!*.md",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "WorkTracker",
      "menuCategory": "WorkTracker",
      "include": "installer.nsi",
      "language": "1033",
      "license": "LICENSE.txt",
      "artifactName": "WorkTracker Setup ${version}.exe",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "warningsAsErrors": false,
      "uninstallDisplayName": "WorkTracker"
    },
    "extraResources": [],
    "protocols": [
      {
        "name": "WorkTracker",
        "schemes": [
          "worktracker"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "uuid": "^11.1.0"
  }
}